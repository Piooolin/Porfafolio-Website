<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Diego Ojeda Diaz</title>
    <meta name="description" content="Portafolio de Diego Alessandro Ojeda Diaz, estudiante de Ingeniería Informática y Sistemas especializado en Análisis de Datos e Inteligencia de Negocios." />
    <meta property="og:title" content="Diego Ojeda Diaz · Portafolio" />
    <meta property="og:description" content="Análisis de datos, Business Intelligence y desarrollo de software." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />

    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png">
    <link rel="manifest" href="~/site.webmanifest">

    <script>
        // Aplica el tema guardado antes de pintar para evitar parpadeos.
        (function () {
            document.documentElement.classList.add('js');
            try {
                var t = localStorage.getItem('tema');
                if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header" id="cabecera">
        <nav class="nav container" aria-label="Principal">
            <a class="brand" asp-page="/Index" aria-label="Inicio">
                <span class="brand-mark">DO</span>
                <span class="brand-name">Diego Ojeda</span>
            </a>

            <ul class="nav-links" id="menu">
                <li><a href="/#sobre-mi">Sobre mí</a></li>
                <li><a href="/#proyectos">Proyectos</a></li>
                <li><a href="/#experiencia">Experiencia</a></li>
                <li><a href="/#formacion">Formación</a></li>
                <li><a href="/#habilidades">Habilidades</a></li>
                <li><a href="/#contacto">Contacto</a></li>
            </ul>

            <div class="nav-actions">
                <button class="icon-btn" id="btnTema" type="button" aria-label="Cambiar tema claro u oscuro">
                    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
                <button class="icon-btn menu-toggle" id="btnMenu" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
            </div>
        </nav>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>&copy; @DateTime.Now.Year Diego Alessandro Ojeda Diaz · Lima, Perú</p>
            <p><a asp-page="/Privacy">Privacidad</a> · <a href="https://github.com/Piooolin/Porfafolio-Website" target="_blank" rel="noopener">Código del sitio</a></p>
        </div>
    </footer>

    <a id="btnVolverArriba" href="#" aria-label="Volver arriba">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </a>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
