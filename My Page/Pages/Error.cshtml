@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<article class="prose container">
    <h1>Algo salió mal</h1>
    <p>Ocurrió un error al procesar tu solicitud. Intenta de nuevo en unos momentos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="muted" style="margin-top:16px">
            ID de solicitud: <code>@Model.RequestId</code>
        </p>
    }

    <p style="margin-top:40px"><a href="/">← Volver al inicio</a></p>
</article>
